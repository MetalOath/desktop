+/**
+ * Returns an ordered array of { type, nativeItem } objects representing the
+ * non-essential tabs and groups in the given workspace, in sidebar order.
+ * Groups appear as a single entry; their member tabs are omitted.
+ *
+ * @param {string} workspaceId
+ * @param {DOMWindow} win
+ * @returns {{ type: "tab"|"group", nativeItem: Element }[]}
+ */
+function getZenWorkspaceItems(workspaceId, win) {
+  if (!win.gZenWorkspaces?.workspaceEnabled) {
+    return [];
+  }
+  const items = [];
+  const usedGroups = new Set();
+  for (const tab of win.gBrowser.tabs) {
+    if (
+      tab.hasAttribute("zen-essential") ||
+      tab.hasAttribute("zen-empty-tab")
+    ) {
+      continue;
+    }
+    if (tab.getAttribute("zen-workspace-id") !== workspaceId) {
+      continue;
+    }
+    const group = tab.group;
+    if (group) {
+      if (!usedGroups.has(group.id)) {
+        usedGroups.add(group.id);
+        items.push({ type: "group", nativeItem: group });
+      }
+    } else {
+      items.push({ type: "tab", nativeItem: tab });
+    }
+  }
+  return items;
+}
+
+/**
+ * Moves item (a tab or group) to the given zenIndex within workspaceId.
+ * Does NOT fire events — callers are responsible for that.
+ *
+ * @param {Element} item  A MozTabbrowserTab or MozTabbrowserTabGroup.
+ * @param {number}  zenIndex  Desired zero-based sidebar position.
+ * @param {string}  workspaceId
+ * @param {DOMWindow} win
+ */
+function moveItemToZenIndex(item, zenIndex, workspaceId, win) {
+  const items = getZenWorkspaceItems(workspaceId, win).filter(
+    i => i.nativeItem !== item
+  );
+  const clampedIndex = Math.max(0, Math.min(zenIndex, items.length));
+  if (clampedIndex >= items.length) {
+    if (items.length > 0) {
+      win.gBrowser.moveTabAfter(item, items[items.length - 1].nativeItem);
+    }
+  } else {
+    win.gBrowser.moveTabBefore(item, items[clampedIndex].nativeItem);
+  }
+}
